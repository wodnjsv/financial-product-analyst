@prefix fp: <urn:ontology:financial-product:v1#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:data:financial-product:2026-08-24-v1> {
  fp:product a fp:FinancialProduct, fp:ETF ; fp:holdsSecurity fp:security .
  fp:security a fp:Security .
  fp:evidence a fp:EvidenceRecord ; fp:sourceRecord fp:source .
  fp:source a fp:SourceRecord .
  fp:weight a fp:HoldingWeightObservation ; fp:observationId "weight" ;
    fp:holdingWeightPercentage "27.4"^^xsd:decimal .
  fp:relation a fp:RelationAssertion ; fp:subject fp:product ; fp:predicate fp:holdsSecurity ;
    fp:object fp:security ; fp:relationId "holding-weight-without-date" ;
    fp:datasetVersion "2026-08-24-v1" ; fp:supportedBy fp:evidence ;
    fp:holdingWeightObservation fp:weight .
}
