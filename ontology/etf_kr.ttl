@prefix fp: <urn:ontology:financial-product:v1#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

fp:etfKrModule owl:imports <urn:ontology:financial-product:v1> .

fp:DomesticETF a owl:Class ; rdfs:subClassOf fp:ETF .
fp:DomesticETN a owl:Class ; rdfs:subClassOf fp:ETN .
