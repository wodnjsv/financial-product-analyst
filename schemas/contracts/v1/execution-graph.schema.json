{
  "$defs": {
    "BindingSpec": {
      "additionalProperties": false,
      "properties": {
        "binding_name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Binding Name",
          "type": "string"
        },
        "cardinality": {
          "$ref": "#/$defs/Cardinality"
        },
        "producer_subtask_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Producer Subtask Id",
          "type": "string"
        },
        "value_type": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Value Type",
          "type": "string"
        }
      },
      "required": [
        "binding_name",
        "value_type",
        "producer_subtask_id",
        "cardinality"
      ],
      "title": "BindingSpec",
      "type": "object"
    },
    "BooleanValue": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "boolean",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "BooleanValue",
      "type": "object"
    },
    "Capability": {
      "enum": [
        "rdb_lookup",
        "graph_traversal",
        "keyword_search",
        "vector_search",
        "financial_calculation",
        "ranking",
        "similarity",
        "comparison"
      ],
      "title": "Capability",
      "type": "string"
    },
    "Cardinality": {
      "enum": [
        "one",
        "many"
      ],
      "title": "Cardinality",
      "type": "string"
    },
    "DateTimeValue": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "datetime",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "format": "date-time",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "DateTimeValue",
      "type": "object"
    },
    "DateValue": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "date",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "format": "date",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "DateValue",
      "type": "object"
    },
    "DecimalValue": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "decimal",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "pattern": "^(?:0|-?[1-9][0-9]*|-?(?:0|[1-9][0-9]*)\\.[0-9]*[1-9])$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "DecimalValue",
      "type": "object"
    },
    "ExecutionTask": {
      "additionalProperties": false,
      "properties": {
        "binding_inputs": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Binding Inputs",
          "type": "array"
        },
        "budget_ms": {
          "exclusiveMinimum": 0,
          "title": "Budget Ms",
          "type": "integer"
        },
        "capability": {
          "$ref": "#/$defs/Capability"
        },
        "depends_on": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "expected_output_type": {
          "$ref": "#/$defs/ResultType"
        },
        "literal_inputs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NamedValue"
          },
          "title": "Literal Inputs",
          "type": "array"
        },
        "operation_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Operation Id",
          "type": "string"
        },
        "produces_bindings": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Produces Bindings",
          "type": "array"
        },
        "required_evidence_fields": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Required Evidence Fields",
          "type": "array"
        },
        "subtask_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Subtask Id",
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "subtask_id",
        "capability",
        "operation_id",
        "expected_output_type",
        "required_evidence_fields",
        "budget_ms"
      ],
      "title": "ExecutionTask",
      "type": "object"
    },
    "IntegerValue": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "integer",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "IntegerValue",
      "type": "object"
    },
    "NamedValue": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "discriminator": {
            "mapping": {
              "boolean": "#/$defs/BooleanValue",
              "date": "#/$defs/DateValue",
              "datetime": "#/$defs/DateTimeValue",
              "decimal": "#/$defs/DecimalValue",
              "integer": "#/$defs/IntegerValue",
              "null": "#/$defs/NullValue",
              "string": "#/$defs/StringValue",
              "tuple": "#/$defs/TupleValue"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NullValue"
            },
            {
              "$ref": "#/$defs/StringValue"
            },
            {
              "$ref": "#/$defs/IntegerValue"
            },
            {
              "$ref": "#/$defs/DecimalValue"
            },
            {
              "$ref": "#/$defs/BooleanValue"
            },
            {
              "$ref": "#/$defs/DateValue"
            },
            {
              "$ref": "#/$defs/DateTimeValue"
            },
            {
              "$ref": "#/$defs/TupleValue"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "NamedValue",
      "type": "object"
    },
    "NullValue": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "null",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "null"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "NullValue",
      "type": "object"
    },
    "ResultType": {
      "enum": [
        "row_set",
        "scalar",
        "entity_ref",
        "relation_path",
        "calculation",
        "comparison_decision"
      ],
      "title": "ResultType",
      "type": "string"
    },
    "StringValue": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "string",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "StringValue",
      "type": "object"
    },
    "TupleValue": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "discriminator": {
              "mapping": {
                "boolean": "#/$defs/BooleanValue",
                "date": "#/$defs/DateValue",
                "datetime": "#/$defs/DateTimeValue",
                "decimal": "#/$defs/DecimalValue",
                "integer": "#/$defs/IntegerValue",
                "null": "#/$defs/NullValue",
                "string": "#/$defs/StringValue"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/NullValue"
              },
              {
                "$ref": "#/$defs/StringValue"
              },
              {
                "$ref": "#/$defs/IntegerValue"
              },
              {
                "$ref": "#/$defs/DecimalValue"
              },
              {
                "$ref": "#/$defs/BooleanValue"
              },
              {
                "$ref": "#/$defs/DateValue"
              },
              {
                "$ref": "#/$defs/DateTimeValue"
              }
            ]
          },
          "title": "Items",
          "type": "array"
        },
        "type": {
          "const": "tuple",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "items"
      ],
      "title": "TupleValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "binding_specs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BindingSpec"
      },
      "title": "Binding Specs",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "critical_path": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Critical Path",
      "type": "array"
    },
    "cutoff_date": {
      "default": "2026-08-24",
      "format": "date",
      "title": "Cutoff Date",
      "type": "string"
    },
    "dataset_version": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Dataset Version",
      "type": "string"
    },
    "graph_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Graph Id",
      "type": "string"
    },
    "producer": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Producer",
      "type": "string"
    },
    "request_key": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Key",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/ExecutionTask"
      },
      "title": "Tasks",
      "type": "array"
    },
    "total_budget_ms": {
      "maximum": 55000,
      "minimum": 0,
      "title": "Total Budget Ms",
      "type": "integer"
    }
  },
  "required": [
    "request_key",
    "run_id",
    "dataset_version",
    "producer",
    "created_at",
    "graph_id",
    "tasks",
    "critical_path",
    "total_budget_ms"
  ],
  "title": "ExecutionGraph",
  "type": "object"
}
