{
  "$defs": {
    "BindingValue": {
      "additionalProperties": false,
      "properties": {
        "binding_name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Binding Name",
          "type": "string"
        },
        "value": {
          "discriminator": {
            "mapping": {
              "boolean": "#/$defs/BooleanValue",
              "date": "#/$defs/DateValue",
              "datetime": "#/$defs/DateTimeValue",
              "decimal": "#/$defs/DecimalValue",
              "integer": "#/$defs/IntegerValue",
              "null": "#/$defs/NullValue",
              "string": "#/$defs/StringValue",
              "tuple": "#/$defs/TupleValue"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NullValue"
            },
            {
              "$ref": "#/$defs/StringValue"
            },
            {
              "$ref": "#/$defs/IntegerValue"
            },
            {
              "$ref": "#/$defs/DecimalValue"
            },
            {
              "$ref": "#/$defs/BooleanValue"
            },
            {
              "$ref": "#/$defs/DateValue"
            },
            {
              "$ref": "#/$defs/DateTimeValue"
            },
            {
              "$ref": "#/$defs/TupleValue"
            }
          ],
          "title": "Value"
        },
        "value_type": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Value Type",
          "type": "string"
        }
      },
      "required": [
        "binding_name",
        "value_type",
        "value"
      ],
      "title": "BindingValue",
      "type": "object"
    },
    "BooleanValue": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "boolean",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "BooleanValue",
      "type": "object"
    },
    "DateTimeValue": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "datetime",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "format": "date-time",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "DateTimeValue",
      "type": "object"
    },
    "DateValue": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "date",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "format": "date",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "DateValue",
      "type": "object"
    },
    "DecimalValue": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "decimal",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "pattern": "^(?:0|-?[1-9][0-9]*|-?(?:0|[1-9][0-9]*)\\.[0-9]*[1-9])$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "DecimalValue",
      "type": "object"
    },
    "Exclusion": {
      "additionalProperties": false,
      "properties": {
        "reason_code": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Reason Code",
          "type": "string"
        },
        "rule_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Rule Id",
          "type": "string"
        },
        "subject_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "rule_id",
        "reason_code"
      ],
      "title": "Exclusion",
      "type": "object"
    },
    "IntegerValue": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "integer",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "IntegerValue",
      "type": "object"
    },
    "NullValue": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "null",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "null"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "NullValue",
      "type": "object"
    },
    "ResultField": {
      "additionalProperties": false,
      "properties": {
        "applicable_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applicable Date"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "field_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Field Id",
          "type": "string"
        },
        "unit_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Id"
        },
        "value": {
          "discriminator": {
            "mapping": {
              "boolean": "#/$defs/BooleanValue",
              "date": "#/$defs/DateValue",
              "datetime": "#/$defs/DateTimeValue",
              "decimal": "#/$defs/DecimalValue",
              "integer": "#/$defs/IntegerValue",
              "null": "#/$defs/NullValue",
              "string": "#/$defs/StringValue",
              "tuple": "#/$defs/TupleValue"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NullValue"
            },
            {
              "$ref": "#/$defs/StringValue"
            },
            {
              "$ref": "#/$defs/IntegerValue"
            },
            {
              "$ref": "#/$defs/DecimalValue"
            },
            {
              "$ref": "#/$defs/BooleanValue"
            },
            {
              "$ref": "#/$defs/DateValue"
            },
            {
              "$ref": "#/$defs/DateTimeValue"
            },
            {
              "$ref": "#/$defs/TupleValue"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "field_id",
        "value"
      ],
      "title": "ResultField",
      "type": "object"
    },
    "ResultRow": {
      "additionalProperties": false,
      "properties": {
        "entity_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Entity Ids",
          "type": "array"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/ResultField"
          },
          "title": "Fields",
          "type": "array"
        },
        "row_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Row Id",
          "type": "string"
        }
      },
      "required": [
        "row_id",
        "entity_ids",
        "fields"
      ],
      "title": "ResultRow",
      "type": "object"
    },
    "ResultType": {
      "enum": [
        "row_set",
        "scalar",
        "entity_ref",
        "relation_path",
        "calculation",
        "comparison_decision"
      ],
      "title": "ResultType",
      "type": "string"
    },
    "ResultWarning": {
      "additionalProperties": false,
      "properties": {
        "related_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Related Ids",
          "type": "array"
        },
        "warning_code": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Warning Code",
          "type": "string"
        }
      },
      "required": [
        "warning_code"
      ],
      "title": "ResultWarning",
      "type": "object"
    },
    "StringValue": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "string",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "StringValue",
      "type": "object"
    },
    "ToolStatus": {
      "enum": [
        "success",
        "empty",
        "unsupported",
        "invalid_input",
        "timeout",
        "transient_error",
        "permanent_error"
      ],
      "title": "ToolStatus",
      "type": "string"
    },
    "TupleValue": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "discriminator": {
              "mapping": {
                "boolean": "#/$defs/BooleanValue",
                "date": "#/$defs/DateValue",
                "datetime": "#/$defs/DateTimeValue",
                "decimal": "#/$defs/DecimalValue",
                "integer": "#/$defs/IntegerValue",
                "null": "#/$defs/NullValue",
                "string": "#/$defs/StringValue"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/NullValue"
              },
              {
                "$ref": "#/$defs/StringValue"
              },
              {
                "$ref": "#/$defs/IntegerValue"
              },
              {
                "$ref": "#/$defs/DecimalValue"
              },
              {
                "$ref": "#/$defs/BooleanValue"
              },
              {
                "$ref": "#/$defs/DateValue"
              },
              {
                "$ref": "#/$defs/DateTimeValue"
              }
            ]
          },
          "title": "Items",
          "type": "array"
        },
        "type": {
          "const": "tuple",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "items"
      ],
      "title": "TupleValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "binding_values": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BindingValue"
      },
      "title": "Binding Values",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "cutoff_date": {
      "default": "2026-08-24",
      "format": "date",
      "title": "Cutoff Date",
      "type": "string"
    },
    "dataset_version": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Dataset Version",
      "type": "string"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "exclusions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Exclusion"
      },
      "title": "Exclusions",
      "type": "array"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "producer": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Producer",
      "type": "string"
    },
    "request_key": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Key",
      "type": "string"
    },
    "result_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Hash",
      "type": "string"
    },
    "result_rows": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResultRow"
      },
      "title": "Result Rows",
      "type": "array"
    },
    "result_type": {
      "$ref": "#/$defs/ResultType"
    },
    "run_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ToolStatus"
    },
    "task_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Task Id",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResultWarning"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "request_key",
    "run_id",
    "dataset_version",
    "producer",
    "created_at",
    "task_id",
    "status",
    "result_type",
    "result_hash",
    "latency_ms"
  ],
  "title": "ToolResult",
  "type": "object"
}
