{
  "$defs": {
    "CutoffStatus": {
      "enum": [
        "eligible",
        "after_cutoff",
        "unknown_vintage",
        "inapplicable"
      ],
      "title": "CutoffStatus",
      "type": "string"
    },
    "EvidenceKind": {
      "enum": [
        "observation",
        "relation",
        "document_span",
        "query_scope",
        "exclusion",
        "policy"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "SourceLocator": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "locator_type": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Locator Type",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "record_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Key"
        },
        "row": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "sentence_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sentence End"
        },
        "sentence_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sentence Start"
        },
        "sheet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet"
        },
        "uri_or_object_key": {
          "title": "Uri Or Object Key",
          "type": "string"
        }
      },
      "required": [
        "locator_type",
        "uri_or_object_key"
      ],
      "title": "SourceLocator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "applicable_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Applicable Date"
    },
    "available_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Available At"
    },
    "currency": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currency"
    },
    "cutoff_status": {
      "$ref": "#/$defs/CutoffStatus"
    },
    "dataset_version": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Dataset Version",
      "type": "string"
    },
    "evidence_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Evidence Id",
      "type": "string"
    },
    "evidence_kind": {
      "$ref": "#/$defs/EvidenceKind"
    },
    "mapping_version": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Mapping Version",
      "type": "string"
    },
    "normalized_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "format": "date",
          "type": "string"
        },
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Normalized Value"
    },
    "parser_version": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Parser Version",
      "type": "string"
    },
    "predicate_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Predicate Id"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published At"
    },
    "raw_value_repr": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Value Repr"
    },
    "record_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Hash",
      "type": "string"
    },
    "scope_completeness": {
      "anyOf": [
        {
          "enum": [
            "closed_world",
            "bounded_unknown"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope Completeness"
    },
    "source_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Source Id",
      "type": "string"
    },
    "source_locator": {
      "$ref": "#/$defs/SourceLocator"
    },
    "subject_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subject Id"
    },
    "unit": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "valid_from": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid From"
    },
    "valid_to": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid To"
    },
    "value_or_object_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "format": "date",
          "type": "string"
        },
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Value Or Object Id"
    },
    "vintage_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vintage Date"
    }
  },
  "required": [
    "evidence_id",
    "evidence_kind",
    "source_id",
    "dataset_version",
    "value_or_object_id",
    "normalized_value",
    "source_locator",
    "parser_version",
    "mapping_version",
    "cutoff_status",
    "record_hash"
  ],
  "title": "EvidenceRecord",
  "type": "object"
}
