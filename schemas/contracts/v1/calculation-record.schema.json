      "title": "Input Calculation Ids",
      "type": "array"
    },
    "input_evidence_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Input Evidence Ids",
      "type": "array"
    },
    "parameters": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CalculationParameter"
      },
      "title": "Parameters",
      "type": "array"
    },
    "population_definition": {
      "anyOf": [
        {
          "$ref": "#/$defs/PopulationDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
