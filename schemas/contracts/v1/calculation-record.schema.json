    },
    "tie_break_rule": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tie Break Rule"
    },
    "unit": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    }
  },
  "required": [
    "calculation_id",
    "calculation_type",
    "formula_id",
    "formula_version",
    "result_value",
    "calculation_hash"
  ],
  "title": "CalculationRecord",
  "type": "object"
}
