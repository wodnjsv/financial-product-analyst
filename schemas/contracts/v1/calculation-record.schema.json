{
  "$defs": {
    "BooleanValue": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "boolean",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "BooleanValue",
      "type": "object"
    },
    "CalculationParameter": {
      "additionalProperties": false,
      "properties": {
        "parameter_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Parameter Id",
          "type": "string"
        },
        "value": {
          "discriminator": {
            "mapping": {
              "boolean": "#/$defs/BooleanValue",
              "date": "#/$defs/DateValue",
              "datetime": "#/$defs/DateTimeValue",
              "decimal": "#/$defs/DecimalValue",
              "integer": "#/$defs/IntegerValue",
              "null": "#/$defs/NullValue",
              "string": "#/$defs/StringValue",
              "tuple": "#/$defs/TupleValue"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NullValue"
            },
            {
              "$ref": "#/$defs/StringValue"
            },
            {
              "$ref": "#/$defs/IntegerValue"
            },
            {
              "$ref": "#/$defs/DecimalValue"
            },
            {
              "$ref": "#/$defs/BooleanValue"
            },
            {
              "$ref": "#/$defs/DateValue"
            },
            {
              "$ref": "#/$defs/DateTimeValue"
            },
            {
              "$ref": "#/$defs/TupleValue"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "parameter_id",
        "value"
      ],
      "title": "CalculationParameter",
      "type": "object"
    },
    "CalculationType": {
      "enum": [
        "conversion",
        "return",
        "ranking",
        "aggregation",
        "comparison",
        "similarity"
      ],
      "title": "CalculationType",
      "type": "string"
    },
    "DateTimeValue": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "datetime",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "format": "date-time",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "DateTimeValue",
      "type": "object"
    },
    "DateValue": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "date",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "format": "date",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "DateValue",
      "type": "object"
    },
    "DecimalValue": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "decimal",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "pattern": "^(?:0|-?[1-9][0-9]*|-?(?:0|[1-9][0-9]*)\\.[0-9]*[1-9])$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "DecimalValue",
      "type": "object"
    },
    "IntegerValue": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "integer",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "IntegerValue",
      "type": "object"
    },
    "NullValue": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "null",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "null"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "NullValue",
      "type": "object"
    },
    "PopulationDefinition": {
      "additionalProperties": false,
      "properties": {
        "filter_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Filter Ids",
          "type": "array"
        },
        "member_count": {
          "minimum": 0,
          "title": "Member Count",
          "type": "integer"
        },
        "population_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Population Hash",
          "type": "string"
        },
        "population_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Population Id",
          "type": "string"
        },
        "scope_evidence_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Scope Evidence Id",
          "type": "string"
        }
      },
      "required": [
        "population_id",
        "scope_evidence_id",
        "filter_ids",
        "member_count",
        "population_hash"
      ],
      "title": "PopulationDefinition",
      "type": "object"
    },
    "StringValue": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "string",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "StringValue",
      "type": "object"
    },
    "TupleValue": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "discriminator": {
              "mapping": {
                "boolean": "#/$defs/BooleanValue",
                "date": "#/$defs/DateValue",
                "datetime": "#/$defs/DateTimeValue",
                "decimal": "#/$defs/DecimalValue",
                "integer": "#/$defs/IntegerValue",
                "null": "#/$defs/NullValue",
                "string": "#/$defs/StringValue"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/NullValue"
              },
              {
                "$ref": "#/$defs/StringValue"
              },
              {
                "$ref": "#/$defs/IntegerValue"
              },
              {
                "$ref": "#/$defs/DecimalValue"
              },
              {
                "$ref": "#/$defs/BooleanValue"
              },
              {
                "$ref": "#/$defs/DateValue"
              },
              {
                "$ref": "#/$defs/DateTimeValue"
              }
            ]
          },
          "title": "Items",
          "type": "array"
        },
        "type": {
          "const": "tuple",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "items"
      ],
      "title": "TupleValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "calculation_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Calculation Hash",
      "type": "string"
    },
    "calculation_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Calculation Id",
      "type": "string"
    },
    "calculation_type": {
      "$ref": "#/$defs/CalculationType"
    },
    "currency": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currency"
    },
    "exclusion_evidence_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Exclusion Evidence Ids",
      "type": "array"
    },
    "formula_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Formula Id",
      "type": "string"
    },
    "formula_version": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Formula Version",
      "type": "string"
    },
    "input_calculation_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Input Calculation Ids",
      "type": "array"
    },
    "input_evidence_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Input Evidence Ids",
      "type": "array"
    },
    "parameters": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CalculationParameter"
      },
      "title": "Parameters",
      "type": "array"
    },
    "population_definition": {
      "anyOf": [
        {
          "$ref": "#/$defs/PopulationDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "result_value": {
      "discriminator": {
        "mapping": {
          "boolean": "#/$defs/BooleanValue",
          "date": "#/$defs/DateValue",
          "datetime": "#/$defs/DateTimeValue",
          "decimal": "#/$defs/DecimalValue",
          "integer": "#/$defs/IntegerValue",
          "null": "#/$defs/NullValue",
          "string": "#/$defs/StringValue"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/NullValue"
        },
        {
          "$ref": "#/$defs/StringValue"
        },
        {
          "$ref": "#/$defs/IntegerValue"
        },
        {
          "$ref": "#/$defs/DecimalValue"
        },
        {
          "$ref": "#/$defs/BooleanValue"
        },
        {
          "$ref": "#/$defs/DateValue"
        },
        {
          "$ref": "#/$defs/DateTimeValue"
        }
      ],
      "title": "Result Value"
    },
    "rounding_rule": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rounding Rule"
    },
    "tie_break_rule": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tie Break Rule"
    },
    "unit": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    }
  },
  "required": [
    "calculation_id",
    "calculation_type",
    "formula_id",
    "formula_version",
    "result_value",
    "calculation_hash"
  ],
  "title": "CalculationRecord",
  "type": "object"
}
